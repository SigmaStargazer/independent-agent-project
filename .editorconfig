# 统一文本文件编码，避免中文等非 ASCII 内容乱码
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
charset = utf-8
indent_style = space
indent_size = 4

[*.{py,pyi}]
charset = utf-8
indent_style = space
indent_size = 4

[*.{json,md,proto,txt,yml,yaml}]
charset = utf-8

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
