# LLM Provider Configuration
# Choose one: "anthropic", "qwen", "kimi", "glm", or "openai"
LLM_PROVIDER=glm

# Anthropic API Configuration (if using Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

