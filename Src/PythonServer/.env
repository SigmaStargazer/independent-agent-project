# Agent模型配置
# GLM4.6
AGENT_API_BASE=https://open.bigmodel.cn/api/paas/v4
AGENT_API_KEY=61383e606d871c028870a8f251a77f08.JH0An7yUOzhd8cIi
AGENT_MODEL=glm-5.1

# 记忆模型配置
MEMORY_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
MEMORY_API_KEY=sk-7a3958e0fdf840e49a2edd83b25dd228
MEMORY_MODEL=qwen-max

# embedding model
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-7a3958e0fdf840e49a2edd83b25dd228
EMBEDDING_MODEL=text-embedding-v4

# reranker model
RERANKER_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
RERANKER_API_KEY=sk-7a3958e0fdf840e49a2edd83b25dd228
RERANKER_MODEL=gte-rerank-v2

# Tavily API Key (optional, for web search)
TAVILY_API_KEY=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

# 记忆存储的队列大小
MEMORY_QUEUE_SIZE=1000

# 以及备份最大数量
MAX_BACKUP_SLOTS = 20

# ===== Prompt 保存与上下文裁剪 =====
# Prompt 保存开关（开发模式）
PROMPT_SAVE_ENABLED=true

# Prompt 保存目录（相对于 PythonServer/）
PROMPT_SAVE_DIR=logs/prompts

# 模型上下文窗口大小（tokens）
AGENT_MAX_CONTEXT_TOKENS=128000

# 上下文保留比例（0.0~1.0，扣除 system prompt / 工具定义 / 输出预留后可用部分的比例）
CONTEXT_RESERVE_RATIO=0.85

# 输出预留 token 数
OUTPUT_RESERVE_TOKENS=4096

